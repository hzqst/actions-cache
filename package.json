{
  "name": "@hzqst/actions-cache",
  "main": "lib/s3.js",
  "types": "lib/s3.d.ts",
  "exports": {
    ".": {
      "types": "./lib/s3.d.ts",
      "default": "./lib/s3.js"
    }
  },
  "files": [
    "lib",
    "dist",
    "restore",
    "save",
    "action.yml",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && ncc build -o dist/restore src/restore.ts && ncc build -o dist/save src/save.ts && ncc build -o dist/saveOnly src/saveOnly.ts",
    "build:lib": "tsc -p tsconfig.lib.json",
    "test": "tsc --noEmit && jest --coverage"
  },
  "dependencies": {
    "@actions/cache": "^5.0.5",
    "@actions/core": "^2.0.3",
    "@types/node": "^20.5.1",
    "minio": "^8.0.7",
    "p-retry": "^6.2.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@vercel/ncc": "^0.44.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.1.6"
  }
}
